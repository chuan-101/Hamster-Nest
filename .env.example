# ==============================================================================
# Hamster-Nest 环境变量清单（示例文件，值全部留空；请勿在仓库里提交任何真实密钥）
# 分三层：前端 Vite / Supabase Edge Functions Secrets / 本地脚本与 CI
# ==============================================================================

# ---------- 前端（Vite）----------
# 本地开发复制本文件为 .env.local 填写（.env.local 已被 .gitignore 忽略）；
# 线上构建（GitHub Pages workflow）从 GitHub Secrets 注入同名变量。

# Supabase 项目 API URL，形如 https://<你的项目ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key（Dashboard → Settings → API Keys 的公开键，配合 RLS 使用）
VITE_SUPABASE_ANON_KEY=

# 可选：设为 1 时关闭首页动效（低配设备 / 自动化测试用）
VITE_NO_FX=

# ---------- Edge Functions（用 `supabase secrets set 名字=值` 配置，不写进任何文件）----------
# 说明：SUPABASE_URL 由 Supabase 平台自动注入 Edge Functions 运行时，无需手动设置。

# 6 个 hamster-*-mcp Edge Function 的共享访问密钥；MCP 客户端以 x-hamster-mcp-key 请求头携带
HAMSTER_MCP_KEY=

# JSON 对象格式的命名密钥表，须包含键 edge_functions_20260715，值为项目的 sb_secret_... 服务密钥
# 例（结构示意）：{"edge_functions_20260715":"sb_secret_..."}，供函数做特权数据库访问与服务间鉴权
SUPABASE_SECRET_KEYS=

# 站主（唯一用户）的 auth 用户 UUID；MCP 与部分函数用它圈定数据归属
HAMSTER_OWNER_USER_ID=

# OpenRouter API key；聊天 / 信件生成 / 记忆提取 / 微信回复等所有 LLM 调用走它
OPENROUTER_API_KEY=

# ElevenLabs TTS：API key 与朗读音色 ID（tts-generate、hamster-life-mcp 的 generate_tts 用）
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Web Push（letter-generate 推送信件通知）：VAPID 公钥 / 私钥 / 联系邮箱（mailto:）
# 可用 `npx web-push generate-vapid-keys` 生成；公钥同时要替换进 src/lib/pushNotifications.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# signal-bus-consumer 的回调共享密钥（外部信号源调用该函数时的鉴权头）
SIGNAL_BUS_SECRET=

# 可选：微信桥 webhook 地址（signal-bus-consumer 把消息转发到微信侧时用；不用微信桥可不设）
CYBERBOSS_WECHAT_WEBHOOK_URL=

# 可选：All About Book 独立 Supabase 项目直连（仅 hamster-reading-mcp 需要；不用阅读域可不设）
AAB_SUPABASE_URL=
AAB_SUPABASE_SERVICE_ROLE_KEY=
AAB_USER_ID=

# 可选：hamster-life-mcp 的第三方代理凭据（瑞幸 / 麦当劳 MCP token、高德地图 key；不用可不设）
LUCKIN_MCP_TOKEN=
MCD_MCP_TOKEN=
AMAP_API_KEY=

# 可选：设为 development 时 openrouter-chat 输出更详细的调试日志
ENV=
DENO_ENV=

# ---------- 本地脚本 / CI ----------

# Supabase 个人访问令牌（Dashboard → Account → Access Tokens）；
# npm run db:types:generate 生成类型、CI 部署 Edge Functions 用
SUPABASE_ACCESS_TOKEN=
